# Only the console build inputs enter the Docker build context.
*
!Dockerfile
!package.json
!LICENSE
!COPYING
!NOTICE
!scripts/
!scripts/console.mjs
!scripts/static.mjs
!scripts/oauth-callback.mjs
!scripts/console-ws.mjs
!docs/
!docs/legal/
!docs/legal/*.md
!frontend/
!frontend/**
frontend/**/node_modules
frontend/dist
frontend/**/.env*
frontend/**/.git
frontend/**/*.credentials.json
frontend/**/auth.json
frontend/**/*.tsbuildinfo
frontend/**/.DS_Store

!supabase/
!supabase/functions/
!supabase/functions/sub2api/
!supabase/functions/sub2api/public_settings.json
