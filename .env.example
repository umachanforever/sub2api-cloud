# Deployment mode: cloud (hosted) or local (Supabase CLI + Docker).
SUPABASE_MODE=cloud

# Used locally by import tooling; injected automatically into deployed Edge Functions.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Generate with: openssl rand -base64 32. Back up this key securely.
GPT_SUBSCRIPTION_CREDENTIALS_KEY_B64=REPLACE_WITH_BASE64_32_BYTE_KEY
# Comma-separated Supabase Auth user UUIDs; user-editable metadata never grants admin.
# Initializes administrator roles once; manage later changes in the console.
SUB2API_ADMIN_USER_IDS=YOUR_ADMIN_AUTH_USER_UUID

# Local Go management endpoint. Docker Compose uses http://management:8080.
MANAGEMENT_URL=http://127.0.0.1:8080

# Optional local console config; never use service_role / secret key here.
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Optional recovery-link destination used by Supabase Auth.
SUPABASE_AUTH_SIGNUP_REDIRECT_URL=http://127.0.0.1:3000/auth/callback
SUPABASE_AUTH_REDIRECT_URL=http://127.0.0.1:3000/reset-password

# Optional CLI account token (or run supabase login).
SUPABASE_ACCESS_TOKEN=
# Remote project database password used by supabase link/db push.
SUPABASE_DB_PASSWORD=

# Optional initial administrator; generated password is saved locally when omitted.
SUB2API_LOCAL_ADMIN_EMAIL=admin@sub2api.local
SUB2API_LOCAL_ADMIN_PASSWORD=

# Optional operations email delivery. Configure a verified sender with Resend.
RESEND_API_KEY=
SUB2API_MAIL_FROM=
