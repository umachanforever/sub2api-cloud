# Deployment mode: cloud (hosted) or local (Supabase CLI + Docker).
SUPABASE_MODE=cloud
# Use the shared Go management schema for the cloud AI request path.
SUB2API_DATA_MODEL=native

# Used locally by import tooling; injected automatically into deployed Edge Functions.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Optional override; leave blank to retrieve via SUPABASE_ACCESS_TOKEN.
SUPABASE_SERVICE_ROLE_KEY=

# Generate with: openssl rand -base64 32. Back up this key securely.
GPT_SUBSCRIPTION_CREDENTIALS_KEY_B64=REPLACE_WITH_BASE64_32_BYTE_KEY
# Comma-separated Supabase Auth user UUIDs; user-editable metadata never grants admin.
# Initializes administrator roles once; manage later changes in the console.
SUB2API_ADMIN_USER_IDS=YOUR_ADMIN_AUTH_USER_UUID

# Local Go management endpoint. Docker Compose connects to its management service.
MANAGEMENT_URL=http://127.0.0.1:8080

# Optional local console config; never use service_role / secret key here.
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Optional recovery-link destination used by Supabase Auth.
SUPABASE_AUTH_SIGNUP_REDIRECT_URL=http://127.0.0.1:3000/auth/callback
SUPABASE_AUTH_REDIRECT_URL=http://127.0.0.1:3000/reset-password

# Supabase Management API token used to provision the isolated management role.
SUPABASE_ACCESS_TOKEN=
# Remote project database password used by supabase link/db push.
SUPABASE_DB_PASSWORD=

# Optional initial administrator; generated password is saved locally when omitted.
SUB2API_LOCAL_ADMIN_EMAIL=admin@sub2api.local
SUB2API_LOCAL_ADMIN_PASSWORD=

# Optional Google OAuth clients for Gemini CLI and Antigravity account authorization.
# Configure your client credentials before using these OAuth flows.
GEMINI_CLI_OAUTH_CLIENT_ID=
GEMINI_CLI_OAUTH_CLIENT_SECRET=
# Optional custom AI Studio OAuth client, shared by management and the cloud gateway.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Optional operations email delivery. Configure a verified sender with Resend.
RESEND_API_KEY=
SUB2API_MAIL_FROM=

# Optional Docker image mirrors for building the management service.
GO_IMAGE=golang:1.27.3-alpine
RUNTIME_IMAGE=postgres:18-alpine
# Optional local ports; both services bind only to loopback.
CONSOLE_PORT=3000
MANAGEMENT_PORT=8080

# Request body limits in bytes, matching upstream Sub2API defaults.
# A zero server limit disables only the global cap; gateway limits still apply.
SERVER_MAX_REQUEST_BODY_SIZE=268435456
GATEWAY_MAX_BODY_SIZE=268435456
GATEWAY_TEXT_MAX_BODY_SIZE=33554432

# Optional Vertex batch image storage; the service account needs access to this bucket.
SUB2API_VERTEX_BATCH_BUCKET=
SUB2API_VERTEX_BATCH_LOCATION=
SUB2API_VERTEX_BATCH_ENVIRONMENT=
