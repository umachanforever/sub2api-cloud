{
  "name": "sub2api-cloud",
  "description": "A developer-friendly AI API gateway for OpenAI, Anthropic, Gemini, and other supported providers, with free-tier Supabase cloud deployment and the original Vue console.",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "LGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "console": "node --env-file-if-exists=.env.local scripts/console.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:database": "S2A_DATABASE_TEST=1 node --test tests/database.test.mjs",
    "credentials:import": "node --env-file=.env.local scripts/import-credentials.mjs",
    "frontend": "pnpm --dir frontend --ignore-workspace dev",
    "deploy": "node --env-file=.env.local scripts/deploy.mjs",
    "verify:cloud": "node scripts/verify-cloud.mjs",
    "up": "node --env-file-if-exists=.env.local scripts/up.mjs",
    "down": "node --env-file-if-exists=.env.local scripts/up.mjs --down",
    "management:setup": "node --env-file=.env.local scripts/management.mjs",
    "usage:link": "node --env-file=.env.local scripts/usage-link.mjs",
    "usage:access": "node --env-file=.env.local scripts/usage-access.mjs",
    "agent:access": "node --env-file=.env.local scripts/agent-access.mjs",
    "verify:independence": "node scripts/verify-independence.mjs"
  },
  "dependencies": {
    "gpt-tokenizer": "4.0.3",
    "nodemailer": "10.1.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2"
  }
}
